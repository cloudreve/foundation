{
  "name": "cloudreve-foundation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p packages/quality/tsconfig.json && tsc -p packages/testkit/tsconfig.json && node tooling/copy-assets.mjs",
    "typecheck": "tsc -p packages/quality/tsconfig.json --noEmit && tsc -p packages/testkit/tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run build && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run arch:check",
    "arch:check": "depcruise --config .dependency-cruiser.cjs packages/*/src",
    "fixture": "node --input-type=module -e \"import {main} from '@cloudreve/testkit/command'; process.exitCode=await main(process.argv.slice(1))\" --",
    "lint": "eslint . --max-warnings 0",
    "test:mutation": "stryker run",
    "lint:fix": "eslint . --fix --max-warnings 0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.5.0",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.5",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "@cloudreve/quality": "workspace:*",
    "@cloudreve/testkit": "workspace:*"
  },
  "workspaces": [
    "packages/*"
  ],
  "description": "Shared development tooling and isolated Community fixtures for Cloudreve projects",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudreve/foundation.git"
  },
  "license": "MIT"
}
